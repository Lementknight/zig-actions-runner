# Copy to deploy/.env (gitignored) to change ports or use Tiger. Compose reads deploy/.env because
# deploy/ holds the first compose file.

# Host ports. The web app is the one to open; the API is published for curl.
WEB_PORT=8080
API_PORT=8081

# Tiger mode only (compose.tiger.yaml). The full connection string, sslmode=require, password
# percent-encoded. Leave unset for the local database; compose.yaml ignores it.
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<db>?sslmode=require
