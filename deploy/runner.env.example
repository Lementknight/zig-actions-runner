# Configuration for the runner (all variables: docs/SPEC.md §2). Copy to runner.env; keep it private.

# A token that may manage self-hosted runners for GH_SCOPE: a fine-grained token with the
# repository permission "Administration: read and write" (an organization: "Self-hosted runners:
# read and write"), or a classic token with `repo` (`admin:org` for an organization).
GH_TOKEN=
# owner/repo, or an organization name.
GH_SCOPE=

# How many jobs this machine runs at once.
RUNNER_COUNT=4
# Labels jobs select with `runs-on: [self-hosted, zig]`.
RUNNER_LABELS=self-hosted,linux,zig
RUNNER_NAME_PREFIX=zig

# Steps run as `runner` (uid 1001, passwordless sudo), as on GitHub; `root` runs them as root.
# RUNNER_STEP_USER=runner
# Experimental: replay the steps after a secret-using step when its output is unchanged.
# RUNNER_OUTPUT_KEYS=false
# uv's project environment lives in uv's cache volume, so uv hardlinks instead of copying every
# file (28.6 s -> 0.5 s for flask on a Raspberry Pi); the workspace's .venv links to it.
# RUNNER_UV_ENV_IN_CACHE=true

# Optional: run state and logs in Postgres / Tiger Data, for the read API and web UI.
# DATABASE_URL=postgres://user:password@host:5432/tsdb?sslmode=require
