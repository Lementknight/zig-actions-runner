# Copy to web/.env.local to change these on your machine. Every .env file except this
# example is gitignored at the repo root, so with no file the defaults below apply.

# Where the app reads runs, jobs and logs.
#   fake  bundled fixtures, no server needed (the default when unset)
#   http  the read API in docs/SPEC.md section 5.3
VITE_DATA_SOURCE=fake

# Base URL of the read API when VITE_DATA_SOURCE=http. Defaults to /api, which the
# dev server proxies to API_PROXY_TARGET.
VITE_API_BASE_URL=/api

# Dev server only, never sent to the browser: where /api is proxied during npm run dev.
# Defaults to http://localhost:8080.
API_PROXY_TARGET=http://localhost:8080
